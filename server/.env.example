# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit your real Gemini key or JWT secret.

# The ONE admin-managed Gemini key. Team members and end users never see this —
# it lives only on the server. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Any long random string — used to sign login tokens. Change this to your own value.
JWT_SECRET=change_this_to_a_long_random_string

# Port the server runs on locally.
PORT=3000
