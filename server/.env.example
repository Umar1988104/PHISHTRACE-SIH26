# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit your real Gemini key, JWT secret, or DB connection string.

# The ONE admin-managed Gemini key. Team members and end users never see this —
# it lives only on the server. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Any long random string — used to sign login tokens. Change this to your own value.
JWT_SECRET=change_this_to_a_long_random_string

# Free MongoDB Atlas connection string (M0 free tier — no credit card needed).
# Create a cluster at https://www.mongodb.com/cloud/atlas/register, then get the
# connection string from Atlas's "Connect > Drivers" screen. It looks like:
MONGODB_URI=mongodb+srv://<your_db_user>:<your_db_password>@<your_cluster>.mongodb.net/phishtrace?retryWrites=true&w=majority

# Port the server runs on locally.
PORT=3000

# Version 7 — shared secret so only your team can view/resolve the manual-review queue.
# Make this up yourself (any long random string) and never share it publicly.
ADMIN_KEY=change_this_to_your_own_secret
